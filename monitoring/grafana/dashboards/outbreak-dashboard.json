      "fieldConfig": {
        "defaults": {
          "unit": "none"
        }
      }
    },
    {
      "id": 2,
      "title": "New Disease Reports Submitted",
      "type": "stat",
      "gridPos": { "h": 6, "w": 8, "x": 8, "y": 0 },
      "targets": [
        {
          "expr": "sum(http_requests_total{route=\"/api/reports\", method=\"POST\"}) or vector(0)",
          "refId": "A",
          "legendFormat": "Reports Created"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none"
        }
      }
